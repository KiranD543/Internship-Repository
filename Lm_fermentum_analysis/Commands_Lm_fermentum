To create csv files for each strain and all strains together:
python3 << 'EOF'
import pandas as pd
import os

# Read all unique gene headers
unique_genes = []
with open('unique_genes_all.fasta', 'r') as f:
    for line in f:
        if line.startswith('>'):
            header = line.strip().lstrip('>')
            genome = ''
            gene_caller = ''
            gene_cluster = ''
            for part in header.split('|'):
                if 'genome_name_' in part:
                    genome = part.replace('genome_name_', '')
                if 'gene_callers_id_' in part:
                    gene_caller = part.replace('gene_callers_id_', '')
                if 'gene_cluster_' in part:
                    gene_cluster = part.replace('gene_cluster_', '')
            unique_genes.append({
                'query': header,
                'genome': genome,
                'gene_cluster': gene_cluster,
                'gene_callers_id': gene_caller
            })

df_genes = pd.DataFrame(unique_genes)

# Load BLAST results
df_blast = pd.read_csv('blast_results_raw.txt', sep='\t', header=None,
                       names=['query', 'subject', 'pident', 'alignment_length',
                              'mismatches', 'gap_opens', 'qstart', 'qend',
                              'sstart', 'send', 'evalue', 'bitscore', 'function'])

# Keep only best hit per query
df_best = df_blast.sort_values('evalue').groupby('query').first().reset_index()

# Merge with unique genes
df_merged = df_genes.merge(df_best[['query', 'subject', 'pident',
                                     'alignment_length', 'evalue',
                                     'bitscore', 'function']],
                            on='query', how='left')

# Fill unknown
df_merged['subject'] = df_merged['subject'].fillna('Unknown')
df_merged['function'] = df_merged['function'].fillna('Unknown - no BLAST hit found')
df_merged['pident'] = df_merged['pident'].fillna(0)
df_merged['evalue'] = df_merged['evalue'].fillna('-')
df_merged['bitscore'] = df_merged['bitscore'].fillna(0)
df_merged['alignment_length'] = df_merged['alignment_length'].fillna(0)

# Save combined CSV
df_merged.to_csv('blast_results_complete.csv', index=False)
print(f"Saved: blast_results_complete.csv")
print(f"Total unique genes: {len(df_merged)}")
print(f"Genes with BLAST hit: {df_merged['subject'].ne('Unknown').sum()}")
print(f"Genes without BLAST hit: {df_merged['subject'].eq('Unknown').sum()}")

# Save per strain CSV
os.makedirs('blast_per_strain', exist_ok=True)
for genome, group in df_merged.groupby('genome'):
    filename = f"blast_per_strain/{genome}_blast.csv"
    group.to_csv(filename, index=False)
    hits = group['subject'].ne('Unknown').sum()
    no_hits = group['subject'].eq('Unknown').sum()
    print(f"{genome}: {hits} hits, {no_hits} unknown → {filename}")
EOF





To add the prokka annotation to the unique gene files:
python3 << 'EOF'
import os
import pandas as pd

# Load gene_data.csv
print("Loading gene_data.csv...")
df = pd.read_csv('panaroo_output/gene_data.csv')
annotation_to_desc = dict(zip(df['annotation_id'], df['description']))
print(f"Loaded {len(annotation_to_desc)} annotations")

def get_gene_descriptions(strain):
    gene_calls_file = f"{strain}_prokka-external-gene-calls.txt"
    gff_file = f"prokka_output/{strain}/{strain}.gff"

    if not os.path.exists(gene_calls_file) or not os.path.exists(gff_file):
        print(f"  Warning: files not found for {strain}")
        return {}

    gene_calls = pd.read_csv(gene_calls_file, sep='\t')

    locus_tags = []
    with open(gff_file, 'r') as f:
        for line in f:
            if '\tCDS\t' in line:
                attrs = line.strip().split('\t')[8]
                for attr in attrs.split(';'):
                    if attr.startswith('locus_tag='):
                        locus_tags.append(attr.replace('locus_tag=', ''))
                        break

    descriptions = {}
    for i, row in gene_calls.iterrows():
        gene_callers_id = row['gene_callers_id']
        if i < len(locus_tags):
            locus_tag = locus_tags[i]
            desc = annotation_to_desc.get(locus_tag, 'hypothetical protein')
            descriptions[gene_callers_id] = desc

    return descriptions

def add_functions_to_fasta(input_dir, output_dir, prefix):
    os.makedirs(output_dir, exist_ok=True)

    for filename in os.listdir(input_dir):
        if not filename.endswith('.fasta'):
            continue

        strain = filename.replace(prefix, '').replace('.fasta', '')
        print(f"Processing: {strain}")

        descriptions = get_gene_descriptions(strain)

        input_path = os.path.join(input_dir, filename)
        output_path = os.path.join(output_dir, filename)

        with open(input_path, 'r') as fin, open(output_path, 'w') as fout:
            for line in fin:
                if line.startswith('>'):
                    header = line.strip().lstrip('>')
                    gene_callers_id = None
                    for part in header.split('|'):
                        if 'gene_callers_id_' in part:
                            try:
                                gene_callers_id = int(part.replace('gene_callers_id_', ''))
                            except:
                                pass

                    desc = descriptions.get(gene_callers_id, 'hypothetical protein')
                    fout.write(f">{header}|function_{desc}\n")
                else:
                    fout.write(line)

        print(f"  Saved: {output_path}")

# Verwerk aminozuur sequenties
print("\n=== Processing amino acid sequences ===")
add_functions_to_fasta(
    'Unique_genes',
    'Unique_genes_annotated',
    'unique_genes_'
)

# Verwerk nucleotide sequenties
print("\n=== Processing nucleotide sequences ===")
add_functions_to_fasta(
    'Unique_genes_nucleotide',
    'Unique_genes_nucleotide_annotated',
    'unique_genes_nucleotide_'
)

print("\nDone!")
EOF







